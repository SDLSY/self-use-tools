{
  "name": "local-md-viewer",
  "version": "1.1.1",
  "description": "本地 Markdown 桌面查看器",
  "author": "Local Tools",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json && node scripts/licenses.mjs && node scripts/stage.mjs",
    "start": "npm run build && electron .",
    "test": "node scripts/test.mjs",
    "test:editor": "node scripts/test-editor.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@fontsource/noto-sans-sc": "5.2.9",
    "dompurify": "3.4.17",
    "highlight.js": "11.11.1",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "12.3.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.10.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "local.tools.mdviewer",
    "productName": "墨阅",
    "artifactName": "MoYue-Setup-${version}-${arch}.${ext}",
    "directories": {
      "app": "app",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "THIRD-PARTY-NOTICES.txt",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    }
  },
  "viewerLibraries": [
    "@fontsource/noto-sans-sc",
    "dompurify",
    "highlight.js",
    "katex",
    "markdown-it",
    "markdown-it-task-lists",
    "mermaid"
  ]
}
