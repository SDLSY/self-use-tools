{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "dist-electron/**",
    "build/**",
    "release/**",
    ".secrets/**",
    "worktrees/**"
  ],
  "rules": {
    "curly": "error",
    "no-else-return": "error",
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-expect-error": "allow-with-description"
      }
    ],
    "import/no-cycle": ["error", { "ignoreTypes": true }]
  },
  "overrides": [
    {
      "files": ["**/*.tsx", "**/*.jsx"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 400,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": ["**/*.mjs", "**/*.cjs"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 600,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": ["**/*.test.*", "**/*.spec.*"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 800,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    }
  ]
}
